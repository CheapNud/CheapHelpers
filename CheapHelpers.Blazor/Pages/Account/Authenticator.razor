@using CheapHelpers.Blazor.Helpers
@using CheapHelpers.Blazor.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize]

<MudText>@Loc["AuthenticatorInstructions"]</MudText>
<MudList T="string">
    <MudListItem>
        <MudText>
            @Loc["DownloadAuthenticatorApp"]
            <MudLink Href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</MudLink> /
            <MudLink Href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</MudLink>
            (Microsoft Authenticator)
            @Loc["Or"]
            <MudLink Href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</MudLink> /
            <MudLink Href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</MudLink>
            (Google Authenticator).
        </MudText>
    </MudListItem>

    <MudListItem>
        <MudText>@Loc["ScanQROrEnterKey"] <kbd>@SharedKey</kbd></MudText>
        <div id="qrCode"></div>
        <div id="qrCodeData" data-url="@AuthenticatorUri"></div>
    </MudListItem>

    <MudListItem>
        <MudText>@Loc["EnterVerificationCode"]</MudText>
    </MudListItem>
</MudList>

<div class="mt-3">
    @* Immediate so Enter verifies the code that was just typed, not the last blurred value *@
    <MudTextField Variant="Variant.Outlined" Label="@Loc["VerificationCode"]" Immediate="true"
                  @bind-Value="VerificationCode" @onkeypress="HandleKeyPress" />
    <MudButton Class="mt-3" Variant="Variant.Filled" FullWidth="true"
               Color="Color.Primary" OnClick="VerifyAsync" Disabled="_verifying">
        @Loc["Verify"]
    </MudButton>
</div>

@code {
    [Parameter] public string AppName { get; set; } = "CheapHelpers";

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    // IAccountIdentityService keeps this page free of user-typed services so it
    // resolves for consumers with derived TUser
    [Inject] protected IAccountIdentityService AccountIdentity { get; set; } = default!;
    [Inject] protected AccountRouteOptions Routes { get; set; } = default!;
    [Inject] protected NavigationManager Nav { get; set; } = default!;
    [Inject] protected ISnackbar ToastService { get; set; } = default!;
    [Inject] protected IStringLocalizer Loc { get; set; } = default!;

    private string SharedKey = "";
    private string AuthenticatorUri = "";
    private string VerificationCode = "";
    private string? _userId;
    private bool _verifying;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        _userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (_userId is null) return;

        try
        {
            var keyInfo = await AccountIdentity.GetOrCreateAuthenticatorKeyAsync(_userId);
            if (keyInfo is null)
            {
                ToastService.Add(Loc["ErrorMessage"], Severity.Error);
                return;
            }

            SharedKey = AuthenticatorHelper.FormatKey(keyInfo.SharedKey);
            AuthenticatorUri = AuthenticatorHelper.GenerateQrCodeUri(AppName, keyInfo.Email ?? "", keyInfo.SharedKey);
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Failed to load authenticator key: {ex.Message}");
            ToastService.Add(Loc["ErrorMessage"], Severity.Error);
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs args)
    {
        if (args.Code is "Enter" or "NumpadEnter")
        {
            await VerifyAsync();
        }
    }

    private async Task VerifyAsync()
    {
        if (_userId is null || _verifying) return;

        _verifying = true;
        try
        {
            var result = await AccountIdentity.EnableAuthenticatorAsync(_userId, VerificationCode);
            if (!result.Succeeded)
            {
                ToastService.Add(Loc["ErrorMessage"], Severity.Error);
                return;
            }

            Nav.NavigateTo(Routes.RecoveryCodesRoute);
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Failed to enable authenticator: {ex.Message}");
            ToastService.Add(Loc["ErrorMessage"], Severity.Error);
        }
        finally
        {
            _verifying = false;
        }
    }
}
