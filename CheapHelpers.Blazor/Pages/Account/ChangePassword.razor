@page "/Account/ChangePassword"
@using CheapHelpers.Blazor.Shared

@attribute [Authorize]

@if (FailedMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@FailedMessage</MudAlert>
}

@* Plain form post: the endpoint refreshes the sign-in cookie, which a circuit cannot do *@
<form method="post" action="@Routes.EndpointPath("ChangePassword")">
    <AntiforgeryToken />
    <MudText Typo="Typo.subtitle2">@Loc["PasswordRules"]</MudText>
    <PasswordTextField Class="mt-3" Label="@Loc["OldPassword"]" name="OldPassword"></PasswordTextField>
    <PasswordTextField Class="mt-3" Label="@Loc["NewPassword"]" name="NewPassword"></PasswordTextField>
    <PasswordTextField Class="mt-3" Label="@Loc["ConfirmPassword"]" name="ConfirmPassword"></PasswordTextField>
    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">@Loc["ChangePassword"]</MudButton>
</form>

@code {
    [Inject] protected IStringLocalizer Loc { get; set; } = default!;
    [Inject] protected AccountRouteOptions Routes { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "failed")] private string? Failed { get; set; }

    // Fixed keys rather than Loc[Failed], so a crafted link cannot put its own text on the page
    private LocalizedString? FailedMessage => Failed is null ? null : Failed switch
    {
        "PasswordMismatch" => Loc["IncorrectPassword"],
        "ConfirmationMismatch" => Loc["PasswordsDoNotMatch"],
        _ when Failed.StartsWith("Password", StringComparison.Ordinal) => Loc["PasswordRequirementsNotMet"],
        _ => Loc["PasswordNotChanged"],
    };
}
