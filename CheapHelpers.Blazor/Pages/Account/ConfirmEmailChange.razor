@page "/Account/ConfirmEmailChange"
@using CheapHelpers.Blazor.Services
@using System.Text
@using Microsoft.AspNetCore.WebUtilities

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudText>@Message</MudText>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "userid")]
    public string UserId { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery(Name = "email")]
    public string Email { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery(Name = "code")]
    public string Code { get; set; } = "";

    private string Message = "";

    [Inject] protected IAccountIdentityService AccountIdentity { get; set; } = default!;
    [Inject] protected ISnackbar ToastService { get; set; } = default!;
    [Inject] protected IStringLocalizer Loc { get; set; } = default!;
    [Inject] protected NavigationManager Nav { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Code))
            {
                ToastService.Add(Loc["ConfirmError"], Severity.Error);
                return;
            }

            var user = await AccountIdentity.FindByIdAsync(UserId);
            if (user is null)
            {
                Debug.WriteLine($"Unable to load user with ID '{UserId}'.");
                ToastService.Add(Loc["ConfirmError"], Severity.Error);
                Nav.NavigateTo("/");
                return;
            }

            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            // Also moves the username along when it was the old email
            var changeResult = await AccountIdentity.ChangeEmailAsync(user.Id, Email, code);

            if (!changeResult.Succeeded)
            {
                Message = Loc["ConfirmError"];
                return;
            }

            Message = Loc["EmailChangeConfirmed"];
        }
        catch (Exception ex)
        {
            Debug.WriteLine(ex.Message);
            ToastService.Add(Loc["ConfirmError"], Severity.Error);
        }
    }
}
