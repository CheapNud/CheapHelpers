@page "/Account/Login"

@using System.Security.Claims;
@using Microsoft.AspNetCore.Authentication;
@using Microsoft.AspNetCore.Authentication.Cookies;
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options;
@using CheapHelpers.Blazor.Shared
@using CheapHelpers.Services.Auth.OAuth

<form @ref=form class="justify-center d-flex mt-6" method="post" action="/Account/SignIn" contextmenu="">
    <MudPaper Elevation=2 Class="pa-6" Style="max-width: 420px;">
        <AntiforgeryToken />
        <MudGrid>
            <MudItem xxl="12" xl="12" md="12" xs="12">
                <MudText Typo="Typo.h4">@Loc["LogIn"]</MudText>
            </MudItem>
            <MudItem xxl="12" xl="12" md="12" xs="12">
                <MudDivider />
            </MudItem>
            @if (FailedMessage is not null)
            {
                <MudItem xxl="12" xl="12" md="12" xs="12">
                    <MudAlert Severity="MudBlazor.Severity.Error">@FailedMessage</MudAlert>
                </MudItem>
            }
            <MudItem xxl="12" xl="12" md="12" xs="12">
                <MudTextField @bind-Value=UserName name="UserName" Clearable=true Placeholder="@Loc["EmailPlaceholder"]" Label="@Loc["Email"]" InputMode=InputMode.email InputType=InputType.Email Variant="Variant.Outlined"></MudTextField>
            </MudItem>
            <MudItem xxl="12" xl="12" md="12" xs="12">
                <PasswordTextField name="Password" @onkeypress="KeySend" @bind-Value="@Password"></PasswordTextField>
            </MudItem>
            <MudItem xxl="12" xl="12" md="12" xs="12">
                <MudButton Variant="Variant.Filled" FullWidth=true Color=Color.Primary ButtonType="ButtonType.Submit">@Loc["LogIn"]</MudButton>
            </MudItem>
            <MudItem xxl="12" xl="12" md="12" xs="12">
                <MudLink Href="Account/ForgotPassword">@Loc["ForgotPassword"]</MudLink>
            </MudItem>
            @if (Providers.Any())
            {
                <MudItem xxl="12" xl="12" md="12" xs="12">
                    <MudDivider />
                </MudItem>
                @foreach (var provider in Providers)
                {
                    <MudItem xxl="12" xl="12" md="12" xs="12">
                        @* Full page load: enhanced navigation would fetch the start endpoint and fail on the provider's cross-origin redirect *@
                        <MudButton Variant="Variant.Outlined" FullWidth="true" Href="@provider.StartPath" StartIcon="@ProviderIcon(provider.ProviderName)" data-enhance-nav="false">@Loc["SignInWith", provider.ProviderName]</MudButton>
                    </MudItem>
                }
            }
        </MudGrid>
    </MudPaper>
</form>

@code {
    public string UserName { get; set; }
    public string Password { get; set; }
    object form;

    [Inject] protected IStringLocalizer Loc { get; set; } = default!;
    [Inject] private IEnumerable<OAuthProviderOptions> Providers { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "failed")] private string? Failed { get; set; }

    // Set by the external sign-in callbacks; only its presence counts, so a crafted link cannot put its own text on the page
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }

    private string? FailedMessage => Failed switch
    {
        "credentials" => Loc["InvalidCredentials"],
        "notallowed" => Loc["AccountNotAllowed"],
        _ when Error is not null => Loc["ExternalSignInFailed"],
        _ => null,
    };

    [Inject]
    private IJSRuntime Js { get; set; }

    private static string ProviderIcon(string providerName) => providerName switch
    {
        "Google" => Icons.Custom.Brands.Google,
        "Microsoft" => Icons.Custom.Brands.Microsoft,
        "GitHub" => Icons.Custom.Brands.GitHub,
        "Apple" => Icons.Custom.Brands.Apple,
        _ => Icons.Material.Filled.Login,
    };

    protected override void OnInitialized()
    {
    }

    private async Task KeySend(KeyboardEventArgs? args = null)
    {
        if (args != null)
        {
            if (args.Code == "Enter" || args.Code == "NumpadEnter")
            {
                await Js.InvokeVoidAsync("submitForm", form);
            }
        }
    }





























