@page "/Account/Login2FA"
@using Microsoft.AspNetCore.Components.Forms
@attribute [AllowAnonymous]

@* SSR form POST to the controller: interactive-circuit TwoFactorAuthenticatorSignInAsync
   can't set auth cookies reliably, and typed SignInManager injection breaks derived-user
   consumers — the controller handles both. *@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="4">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">
            <MudIcon Icon="Icons.Material.Filled.Security" Class="me-2" />
            @Loc["TwoFactorAuthentication"]
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-4" Align="Align.Center">
            @Loc["AuthenticatorCodePrompt"]
        </MudText>

        @if (Failed == "code")
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@Loc["InvalidAuthenticatorCode"]</MudAlert>
        }

        <form method="post" action="/Account/SignInWith2fa">
            <AntiforgeryToken />

            <MudTextField T="string"
                          name="TwoFactorCode"
                          Label="@Loc["AuthenticatorCode"]"
                          Placeholder="123456"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          MaxLength="10"
                          InputMode="InputMode.numeric"
                          HelperText="@Loc["EnterCodeFromApp"]" />

            @* Native checkbox: MudCheckBox does not post a form value on plain form submission *@
            <label class="d-flex align-center mb-4 mud-text-secondary">
                <input type="checkbox" name="RememberMachine" value="true" class="me-2" />
                @Loc["RememberThisMachine"]
            </label>

            <MudStack Spacing="3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           ButtonType="ButtonType.Submit">
                    <MudIcon Icon="Icons.Material.Filled.Login" Class="me-2" />
                    @Loc["SignIn"]
                </MudButton>

                <MudDivider />

                <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-2">
                    @Loc["DontHaveAccess"]
                </MudText>

                <MudLink Href="/Account/LoginWithRecoveryCode" Class="d-flex align-center justify-center">
                    <MudIcon Icon="Icons.Material.Filled.VpnKey" Class="me-2" />
                    @Loc["UseRecoveryCode"]
                </MudLink>
            </MudStack>
        </form>
    </MudPaper>
</MudContainer>

@code {
    [Inject] private IStringLocalizer Loc { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "failed")] private string? Failed { get; set; }
}
