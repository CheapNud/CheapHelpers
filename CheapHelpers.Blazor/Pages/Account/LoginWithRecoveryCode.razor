@page "/Account/LoginWithRecoveryCode"
@using Microsoft.AspNetCore.Components.Forms
@attribute [AllowAnonymous]

@* SSR form POST to the controller — see LoginWith2fa.razor for why *@

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-6" Elevation="4">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">
            <MudIcon Icon="Icons.Material.Filled.VpnKey" Class="me-2" />
            @Loc["RecoveryCodeLogin"]
        </MudText>

        <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-4">
            @Loc["RecoveryCodeDescription"]
        </MudAlert>

        @if (Failed == "code")
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@Loc["InvalidRecoveryCode"]</MudAlert>
        }

        <form method="post" action="/Account/SignInWithRecoveryCode">
            <AntiforgeryToken />

            <MudTextField T="string"
                          name="RecoveryCode"
                          Label="@Loc["RecoveryCode"]"
                          Placeholder="XXXX-XXXX"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          MaxLength="20"
                          HelperText="@Loc["EnterRecoveryCodeHelp"]" />

            <MudStack Spacing="3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           ButtonType="ButtonType.Submit">
                    <MudIcon Icon="Icons.Material.Filled.Login" Class="me-2" />
                    @Loc["SignInWithRecoveryCode"]
                </MudButton>

                <MudDivider />

                <MudLink Href="/Account/Login2FA" Class="d-flex align-center justify-center">
                    <MudIcon Icon="Icons.Material.Filled.ArrowBack" Class="me-2" />
                    @Loc["BackToAuthenticator"]
                </MudLink>
            </MudStack>
        </form>

        <MudAlert Severity="MudBlazor.Severity.Warning" Class="mt-4">
            <MudText Typo="Typo.caption">
                <strong>@Loc["Important"]:</strong> @Loc["RecoveryCodeWarning"]
            </MudText>
        </MudAlert>
    </MudPaper>
</MudContainer>

@code {
    [Inject] private IStringLocalizer Loc { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "failed")] private string? Failed { get; set; }
}
