@page "/Account/SetPassword"
@using CheapHelpers.Blazor.Services
@using CheapHelpers.Blazor.Shared
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

<MudText Typo="Typo.h4">@Loc["SetPassword"]</MudText>
<MudText Typo="Typo.body1" Class="mb-4">@Loc["SetPasswordDescription"]</MudText>

@if (FailedMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@FailedMessage</MudAlert>
}

@* Plain form post: the endpoint refreshes the sign-in cookie, which a circuit cannot do *@
<form method="post" action="@Routes.EndpointPath("SetPassword")">
    <AntiforgeryToken />
    <MudText Typo="Typo.subtitle2">@Loc["PasswordRules"]</MudText>
    <PasswordTextField Class="mt-3" Label="@Loc["NewPassword"]" name="NewPassword"></PasswordTextField>
    <PasswordTextField Class="mt-3" Label="@Loc["ConfirmPassword"]" name="ConfirmPassword"></PasswordTextField>

    <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">
        @Loc["SetPassword"]
    </MudButton>
</form>

@code {
    [Inject] private IAccountIdentityService AccountIdentity { get; set; } = default!;
    [Inject] private IStringLocalizer Loc { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AccountRouteOptions Routes { get; set; } = default!;

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "failed")] private string? Failed { get; set; }

    // Fixed keys rather than Loc[Failed], so a crafted link cannot put its own text on the page
    private LocalizedString? FailedMessage => Failed is null ? null : Failed switch
    {
        "ConfirmationMismatch" => Loc["PasswordsDoNotMatch"],
        _ when Failed.StartsWith("Password", StringComparison.Ordinal) => Loc["PasswordRequirementsNotMet"],
        _ => Loc["PasswordNotSet"],
    };

    protected override async Task OnInitializedAsync()
    {
        var user = await AccountIdentity.GetUserAsync((await AuthenticationStateTask).User);
        if (user is not null && await AccountIdentity.HasPasswordAsync(user.Id))
        {
            // User already has a password, redirect to change password
            Nav.NavigateTo("/Account");
        }
    }
}
