@using Microsoft.Extensions.DependencyInjection

@* House rule: any async action self-disables, swaps its StartIcon for a spinner,
   guards re-entry and resets in finally — never a bare MudButton on an awaited call. *@
<MudButton @attributes="@CapturedAttributes"
           HtmlTag="@HtmlTag"
           Class="@Class"
           Variant="@Variant"
           Color="@Color"
           OnClick="Clicked"
           StartIcon="@(processing ? null : StartIcon)"
           Size="@Size"
           FullWidth=@FullWidth
           Disabled=@(Disabled || processing)
           Ripple=@(!processing)
           for="@For">
    @if (processing)
    {
        <MudProgressCircular Class="ms-n1 mr-2" Size="MudBlazor.Size.Small" Indeterminate="true" Color="MudBlazor.Color.Inherit" />
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (processing)
    {
        <MudText>@processingText</MudText>
    }
    else
    {
        @ButtonText
    }
</MudButton>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> CapturedAttributes { get; set; }

    [Parameter]
    public string Class { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// Legacy text content. Prefer <see cref="ChildContent"/>; when both are set, ChildContent wins.
    /// </summary>
    [Parameter]
    public string ButtonText { get; set; }

    /// <summary>
    /// Button content. Stays visible while running (spinner is prepended, StartIcon hidden).
    /// </summary>
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string HtmlTag { get; set; }

    [Parameter]
    public string For { get; set; }

    [Parameter]
    public bool FullWidth { get; set; } = false;

    [Parameter]
    public string StartIcon { get; set; }

    [EditorRequired]
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public MudBlazor.Color Color { get; set; } = Color.Primary;

    [Parameter]
    public MudBlazor.Variant Variant { get; set; } = Variant.Filled;

    [Parameter]
    public MudBlazor.Size Size { get; set; } = Size.Medium;

    /// <summary>
    /// When set, an exception thrown by <see cref="OnClick"/> is passed here instead of propagating
    /// </summary>
    [Parameter]
    public EventCallback<Exception> OnError { get; set; }

    // The non-generic IStringLocalizer is only registered by AddCheapHelpersBlazor; a plain
    // [Inject] would fail to render in apps that only call AddMudServices
    [Inject] private IServiceProvider Services { get; set; } = default!;

    private const string DefaultProcessingText = "Processing";

    private string processingText = DefaultProcessingText;

    private bool processing = false;

    protected override void OnInitialized() =>
        processingText = Services.GetService<IStringLocalizer>()?[DefaultProcessingText] ?? DefaultProcessingText;

    private async Task Clicked(MouseEventArgs args)
    {
        // Re-entry guard: a double-click before the first render disables the button
        // would fire the handler twice
        if (processing)
        {
            return;
        }

        processing = true;
        try
        {
            await OnClick.InvokeAsync(args);
        }
        catch (Exception ex) when (OnError.HasDelegate)
        {
            await OnError.InvokeAsync(ex);
        }
        finally
        {
            // Reset even when the handler throws, so the button doesn't stay stuck
            processing = false;
        }
    }
}
